# Client-visible configuration (safe to expose)
VITE_PAYMENT_PROVIDER=razorpay
VITE_SITE_URL=https://ateliernoir.example

# Server-only secrets — never import these in client code.
# Add them through the project's secret store, not a committed .env file.
DATABASE_URL=
SESSION_SECRET=

# Payment gateway (choose one provider)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email
EMAIL_API_KEY=
